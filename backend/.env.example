PORT=5000
NODE_ENV=development
JWT_SECRET=clinical_ai_default_secret_change_in_production_key_38472948
JWT_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Supabase Credentials (from Supabase Project Settings -> API)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# AI Inference Service Configuration
# AI_MODE can be "demo" (simulated Multi-Instance Learning) or "real" (points to external Python MIL microservice)
AI_MODE=demo
AI_SERVICE_URL=http://localhost:8000
AI_TIMEOUT_MS=15000

# File Upload Settings (50MB maximum by default)
MAX_UPLOAD_SIZE=52428800
